# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# Base URL of the real backend (local: http://localhost:3001; production: deployed API origin).
# Leave empty/unset to use the built-in mock backend at /api/mock — in development only.
NEXT_PUBLIC_API_URL=

# Production builds never fall back to the mock: without NEXT_PUBLIC_API_URL they show
# a "not connected" message. Set this to "true" only to deploy the mock on purpose
# (e.g. a demo on Vercel); the page then shows a "Demo mode" note.
NEXT_PUBLIC_USE_MOCK_API=
