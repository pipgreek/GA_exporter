# Copy to .env.local and adjust. NEXT_PUBLIC_* values are baked in at build time.

# Base URL of the backend (local: http://localhost:3001; production: deployed API origin).
# Required: without it the home page shows "Service unavailable". There is no demo mode.
#
# For UI work without a backend, use the built-in mock (development only, `npm run dev`):
#   NEXT_PUBLIC_API_URL=http://localhost:3000/api/mock
NEXT_PUBLIC_API_URL=

# --- Login (shared password) ---
# Server-side only: no NEXT_PUBLIC_ prefix, so these are never sent to the browser.
# Set the shared password here (and in the host's environment variables when deployed).
# While AUTH_PASSWORD is empty or missing, nobody can log in.
AUTH_PASSWORD=
# The one username (email) that can log in (case-insensitive). Defaults to info@vilabs.eu.
AUTH_EMAIL=info@vilabs.eu
