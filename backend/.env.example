NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Local Redis from docker compose; use a rediss:// URL for Upstash.
REDIS_URL=redis://127.0.0.1:6379
PDF_PYTHON_EXECUTABLE=python
JOB_RETENTION_SECONDS=86400

# Supabase Storage (service role key is server-side only; never expose it to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ga-exporter

# Anthropic API (Claude Haiku) — used by the three generate<Name>Json() extraction calls.
ANTHROPIC_API_KEY=
# Number of retries after the first attempt when the tool_use output fails
# Zod validation or the API call errors (implementation-plan.md §5.E).
LLM_MAX_RETRIES=2
# Directory containing info/gantt/kpi.request.json. Leave unset to use the
# repo-root llm/prompts/ directory (resolved relative to this package).
LLM_PROMPTS_DIR=
