NODE_ENV=development
PORT=3000

# Local Redis from docker compose; use a rediss:// URL for Upstash.
REDIS_URL=redis://127.0.0.1:6379
PDF_PYTHON_EXECUTABLE=python
JOB_RETENTION_SECONDS=86400

# Supabase Storage (service role key is server-side only; never expose it to the frontend).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=ga-exporter

# Added when the LLM integration is implemented.
ANTHROPIC_API_KEY=
